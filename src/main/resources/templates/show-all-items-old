<!DOCTYPE html>
<html xmlns:th="http://www.thymeleaf.org">

<head>

<link rel="stylesheet" th:href="@{/css/navbar.css}" />

<style>
table {
	width: 95%;
	border-collapse: separate;
	border-spacing: 0 6px;
	font-family: Arial, sans-serif;
	border: none;
	box-shadow: 0 2px 6px rgba(0, 0, 0, 0.06);
}

thead th {
	text-align: center;
	padding: 6px;
	color: #374151;
	background: #ededb9;
	border: 1px #e6e65c;
}

tbody tr {
	box-shadow: 0 2px 6px rgba(0, 0, 0, 0.06);
	margin: auto auto;
}

td {
	padding: 8px;
	margin: auto auto;
	text-align: center;
}

/* tbody tr td:first-child {
	border-top-left-radius: 8px;
	border-bottom-left-radius: 8px;
}

tbody tr td:last-child {
	border-top-right-radius: 8px;
	border-bottom-right-radius: 8px;
} */
tbody tr:hover {
	transform: scale(1.01);
	transition: 0.2s;
	background: #efefef;
}

button {
	margin: 3px 3px;
	padding: 10px 10px;
	cursor: pointer;
}

button:hover {
	transform: scale(1.01);
	transition: 0.2s;
}

#viewShipmentDetails {
	background-color: #b4dcef;
	color: #5015b9;
	font-weight: bold;
	text-decoration: none;
	margin: 3px 3px;
	padding: 10px 10px;
	cursor: pointer;
}

.href-styling {
	display: inline-block;
	font-weight: bold;
	padding: 10px 20px;
	text-decoration: none;
	border-radius: 6px;
}

.active-a-tag {
	background-color: #4CAF50;
	color: white;
	pointer-events: none;
	border: 2px solid green;
}

/* ── Filter Bar ── */
.filter-bar {
	display: flex;
	align-items: center;
	margin: 16px 0 10px 0;
}

.filter-bar form {
	display: flex;
	align-items: center;
	gap: 10px;
	background: #f0f4ff;
	border: 1px solid #c5cff5;
	border-radius: 10px;
	padding: 10px 18px;
}

.filter-bar label {
	font-family: Arial, sans-serif;
	font-size: 0.82rem;
	font-weight: 700;
	color: #4a4e8a;
	text-transform: uppercase;
	letter-spacing: 0.06em;
	white-space: nowrap;
}

.filter-bar select {
	padding: 8px 14px;
	border: 1.5px solid #b0baf5;
	border-radius: 7px;
	font-size: 0.92rem;
	font-family: Arial, sans-serif;
	color: #2c2f6b;
	background: #ffffff;
	cursor: pointer;
	min-width: 220px;
	outline: none;
	transition: border-color 0.2s;
}

.filter-bar select:focus {
	border-color: #6a73b2;
}

.filter-bar button {
	padding: 8px 22px;
	background-color: #6a73b2;
	color: #ffffff;
	font-weight: 700;
	font-size: 0.88rem;
	font-family: Arial, sans-serif;
	border: none;
	border-radius: 7px;
	cursor: pointer;
	letter-spacing: 0.04em;
	transition: background-color 0.2s, transform 0.15s;
	margin: 0;
}

.filter-bar button:hover {
	background-color: #555fa0;
	transform: translateY(-1px);
}
</style>

</head>

<body>

	<div th:replace="~{fragments/navbar :: navbar}"></div>

	<!-- 	<h2>All Warehouses</h2>
 -->
	<br />
	<p th:if="${msg}" id="msgBox"
		th:style="'background:' + ${bgColor} + '; color:' + ${textColor} + '; padding:10px; border-radius:6px; position:relative; font-weight:bold;'">
		<span th:text="${msg}"></span>&nbsp;&nbsp;&nbsp;&nbsp;
		<!-- ❌ Close button -->
		<span onclick="this.parentElement.style.display='none'"
			style="position: absolute; margin: auto; right: 14px; cursor: pointer; font-weight: bold;">
			X </span>
	</p>

	<a href="/items/goToCreateItemPage"
		style="display: inline-block; background-color: #4CAF50; color: #fcfaf5; font-weight: bold; padding: 10px 20px; text-decoration: none; border-radius: 6px;">Create
		New Item</a>
	<br />
	<div class="filter-bar">
		<!--  customer-id in form action will be dynamically updated in script -->
		<form id="customerForm" th:action="@{/items/showItemsByCustomer/ALL}"
			method="post">
			<label for="customerId">Filter by Customer</label> <select
				name="customerId" id="customerId" required
				onchange="updateFormAction(this.value)">
				<option value="ALL">— Show ALL —</option>
				<option th:each="c : ${customers}" th:value="${c.customerId}"
					th:selected="${c.customerId == selectedCustomer}"
					th:text="|${c.customerId} = ${c.customerName}|"></option>
			</select>
			<button type="submit">Apply Filter</button>
		</form>
	</div>

	<table border="1">
		<thead>
			<tr>
				<th>Customer</th>
				<th>Item</th>
				<th>Description</th>
				<th>UOM</th>
				<th>Status</th>
				<th>Created At</th>
				<th>Modified At</th>
				<th colspan="2">Actions</th>
			</tr>
		</thead>

		<!--	<td th:text="${items}"></td>-->


		<tr th:each="i : ${items}">
			<input type="hidden" name="itemCustomerUomId"
				th:value="${i.itemCustomerUomId}" />


			<td><a target="_blank" style="color: blue; font: bold;"
				th:href="@{'/customers/showCustomerDetails/' + ${i.customerId}}"
				th:text="${i.customerId}"> </a></td>
			<td th:text="${i.itemId}"></td>
			<td th:text="${i.itemDescription}"></td>
			<td th:text="${i.itemUom}"></td>
			<!-- 						<td th:text="${i.itemStatus}"></td> 
 -->
			<td><span th:text="${i.itemStatus}"
				th:style="${i.itemStatus == 'Active'} ? 
                    'background:#d4edda; color:#155724; padding:3px 10px; border-radius:12px; font-weight:bold;' : 
                    'background:#f8d7da; color:#721c24; padding:3px 10px; border-radius:12px; font-weight:bold;'">
			</span></td>

			<td th:text="${i.createdAt}"></td>
			<td th:text="${i.modifiedAt}"></td>
			<td><a
				th:href="@{'/items/viewOrEditItem/' + ${i.itemCustomerUomId}}"
				style="display: inline-block; background-color: #6a73b2; color: #fcfaf5; font-weight: bold; padding: 10px 20px; font-size: 13px; text-decoration: none; border-radius: 6px; border-color: white; cursor: pointer;">View
					/ Edit Item</a></td>
			<td>
				<form th:action="@{'/items/deleteItem/' + ${i.itemCustomerUomId}}"
					method="post">
					<button type="submit"
						onclick="return confirm('Are you sure you want to delete this item?')"
						style="display: inline-block; background-color: #ed4758; color: #ffffff; font-weight: bold; padding: 10px 20px; font-size: 13px; text-decoration: none; border-radius: 6px; border-color: white; cursor: pointer;">Delete
						Item</button>
				</form>
			</td>
		</tr>
	</table>

	<!-- Show this if items list is EMPTY -->
	<div th:if="${#lists.isEmpty(items)}"
		style="text-align: center; color: #888;">
		<p style="font-size: 1.1rem; margin-bottom: 10px;">No Items
			records to display.</p>
		<br /> <a href="/items/goToCreateItemPage"
			style="background: #4CAF50; color: white; padding: 8px 18px; border-radius: 6px; text-decoration: none; font-weight: bold;">
			Create New Item </a>
	</div>

	<script>
		window.addEventListener("load", function() {
			var msg = document.getElementById("msgBox");
			if (msg) {
				setTimeout(function() {
					msg.style.display = "none";
				}, 10000);
			}
		});
		

  // dynamically update the form-action based on the selected customer-id
		    function updateFormAction(customerId) {
		        document.getElementById('customerForm').action = 
		            '/items/showItemsByCustomer/' + customerId;
		    } 
		
	</script>

</body>

</html>